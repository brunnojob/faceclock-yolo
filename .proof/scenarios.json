{
  "repository": "brunnojob/faceclock-yolo",
  "inputs": [
    ".proof/scenarios.json",
    ".proof/demo.py"
  ],
  "cases": [
    {
      "name": "python -m pip install -r requirements.txt",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "python -m pip install -r requirements.txt"
      ],
      "timeout": 900,
      "display": false
    },
    {
      "name": "python -m unittest discover -v -s tests",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "python -m unittest discover -v -s tests"
      ],
      "timeout": 900,
      "display": true
    },
    {
      "name": "python -m unittest discover -v -s cloud",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "python -m unittest discover -v -s cloud"
      ],
      "timeout": 900,
      "display": true
    },
    {
      "name": "Synthetic embedding review, consent, revocation and audit integrity",
      "argv": [
        "python",
        ".proof/demo.py"
      ],
      "contains": [
        "\"review_required\": true",
        "\"tampering_detected\": true"
      ],
      "timeout": 120
    }
  ]
}
